---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Text from '../components/Text.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  current?: string;
}
const { title, description, image = '/assets/brand/tenon-og.png', current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/brand/tenon-avatar.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/brand/tenon-avatar-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        try {
          const params = new URLSearchParams(location.search);
          const requested = (params.get('lang') || '').toLowerCase();
          const browser = (
            (navigator.languages && navigator.languages[0]) ||
            navigator.language ||
            'en'
          ).toLowerCase();
          const lang = requested
            ? requested.startsWith('zh') ? 'zh' : 'en'
            : browser.startsWith('zh') ? 'zh' : 'en';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang === 'zh' ? 'zh-Hans' : 'en';
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      <Text en="Skip to content" zh="跳到正文" />
    </a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const requested = (params.get('lang') || '').toLowerCase();
        if (requested !== 'zh' && requested !== 'en') return;

        document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
          const url = new URL(anchor.href);
          if (url.origin !== location.origin) return;
          url.searchParams.set('lang', requested);
          anchor.setAttribute('href', url.pathname + url.search + url.hash);
        });
      })();
    </script>
  </body>
</html>
