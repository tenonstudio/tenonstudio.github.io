---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Text from '../components/Text.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  current?: string;
}
const { title, description, image = '/assets/brand/tenon-og.png', current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/brand/tenon-avatar.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/brand/tenon-avatar-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        try {
          const params = new URLSearchParams(location.search);
          const saved = params.get('lang') || localStorage.getItem('tenon-lang');
          const lang = saved || ((navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en');
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang === 'zh' ? 'zh-Hans' : 'en';
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      <Text en="Skip to content" zh="跳到正文" />
    </a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = [...document.querySelectorAll('[data-set-lang]')];
        const sync = () => {
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.setLang === root.dataset.lang));
          });
          root.classList.add('lang-ready');
        };
        const setLang = (lang) => {
          root.dataset.lang = lang;
          root.lang = lang === 'zh' ? 'zh-Hans' : 'en';
          try { localStorage.setItem('tenon-lang', lang); } catch {}
          sync();
        };
        buttons.forEach((button) => button.addEventListener('click', () => setLang(button.dataset.setLang)));
        sync();
      })();
    </script>
  </body>
</html>
