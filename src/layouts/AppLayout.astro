---
import '../styles/global.css';
import Text from '../components/Text.astro';
import { SITE } from '../data/site';
import type { App } from '../data/apps';

interface Props {
  app: App;
  title: string;
  description: string;
  image?: string;
  current?: 'overview' | 'support' | 'privacy' | 'terms' | 'buy' | 'help';
}

const { app, title, description, image = app.icon, current = 'overview' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const year = new Date().getFullYear();

const navigation = [
  { id: 'overview', href: `/apps/${app.slug}/`, label: { en: 'Overview', zh: '概览' } },
  { id: 'support', href: `/apps/${app.slug}/support.html`, label: { en: 'Support', zh: '支持' } },
  { id: 'privacy', href: `/apps/${app.slug}/privacy.html`, label: { en: 'Privacy', zh: '隐私' } },
  { id: 'terms', href: `/apps/${app.slug}/terms.html`, label: { en: 'Terms', zh: '条款' } }
] as const;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#f9fafd" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={app.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href={app.icon} />
    <link rel="apple-touch-icon" href={app.icon} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        try {
          const params = new URLSearchParams(location.search);
          const requested = (params.get('lang') || '').toLowerCase();
          const browser = (
            (navigator.languages && navigator.languages[0]) ||
            navigator.language ||
            'en'
          ).toLowerCase();
          const lang = requested
            ? requested.startsWith('zh') ? 'zh' : 'en'
            : browser.startsWith('zh') ? 'zh' : 'en';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang === 'zh' ? 'zh-Hans' : 'en';
        } catch {}
      })();
    </script>
  </head>
  <body style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}>
    <a class="skip-link" href="#main">
      <Text en="Skip to content" zh="跳到正文" />
    </a>

    <header class="app-header">
      <div class="app-header-inner">
        <a class="app-brand" href={`/apps/${app.slug}/`} aria-label={app.name}>
          <img src={app.icon} alt="" width="32" height="32" />
          <span>{app.name}</span>
        </a>
        {app.download ? (
          <a class="app-header-cta" href={app.download}>
            <Text en="Download" zh="下载" /> <span aria-hidden="true">↓</span>
          </a>
        ) : app.status === 'in-development' ? (
          <span class="app-header-cta is-soon"><Text en="In development" zh="开发中" /></span>
        ) : (
          <span class="app-header-cta is-soon"><Text en="Downloads paused" zh="下载暂停" /></span>
        )}
      </div>
      <nav class="app-nav" aria-label={`${app.name} navigation`}>
        {navigation.map((item) => (
          <a
            href={item.href}
            class:list={[{ 'is-active': current === item.id }]}
            aria-current={current === item.id ? 'page' : undefined}
          >
            <Text en={item.label.en} zh={item.label.zh} />
          </a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="app-footer">
      <div class="app-footer-inner">
        <a class="app-footer-brand" href={`/apps/${app.slug}/`}>
          <img src={app.icon} alt="" width="40" height="40" />
          <span>
            <strong>{app.name}</strong>
            <small><Text en={app.tagline.en} zh={app.tagline.zh} /></small>
          </span>
        </a>
        <nav class="app-footer-nav" aria-label={`${app.name} resources`}>
          <a href={`/apps/${app.slug}/support.html`}><Text en="Support" zh="支持" /></a>
          <a href={`/apps/${app.slug}/privacy.html`}><Text en="Privacy Policy" zh="隐私政策" /></a>
          <a href={`/apps/${app.slug}/terms.html`}><Text en="Terms of Use" zh="使用条款" /></a>
          <a href="/#apps"><Text en="All Tenon apps" zh="全部 Tenon 应用" /></a>
        </nav>
        <div class="app-footer-meta">
          <span>{app.platform}</span>
          <span aria-hidden="true">·</span>
          <Text en={app.category.en} zh={app.category.zh} />
          {app.status === 'in-development' && (
            <>
              <span aria-hidden="true">·</span>
              <Text en="In development" zh="开发中" />
            </>
          )}
          <span class="app-footer-copy">© {year} <a href="/">{SITE.name}</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const requested = (params.get('lang') || '').toLowerCase();
        if (requested !== 'zh' && requested !== 'en') return;

        document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
          const url = new URL(anchor.href);
          if (url.origin !== location.origin) return;
          url.searchParams.set('lang', requested);
          anchor.setAttribute('href', url.pathname + url.search + url.hash);
        });
      })();
    </script>
  </body>
</html>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(249, 250, 253, .9);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .app-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 14px 32px 9px;
  }

  .app-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -.02em;
    text-decoration: none;
  }

  .app-brand img {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    box-shadow: 0 6px 14px rgba(26, 41, 71, .14);
  }

  .app-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    background: var(--ink);
    border-radius: 999px;
    color: var(--bg);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s ease, transform .2s ease;
  }

  .app-header-cta:hover {
    background: #34332d;
    transform: translateY(-1px);
  }

  .app-header-cta.is-soon {
    background: var(--app-soft);
    color: var(--app-accent);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .app-nav {
    display: flex;
    gap: 24px;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px 11px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .app-nav::-webkit-scrollbar {
    display: none;
  }

  .app-nav a {
    padding: 4px 0;
    border-bottom: 1.5px solid transparent;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s ease, border-color .2s ease;
  }

  .app-nav a:hover {
    color: var(--ink);
  }

  .app-nav a.is-active {
    border-color: var(--app-accent);
    color: var(--ink);
  }

  .app-footer {
    margin-top: 48px;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .app-footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 40px;
    align-items: start;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 34px 32px 30px;
  }

  .app-footer-brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 12px;
    width: fit-content;
    color: var(--ink);
    text-decoration: none;
  }

  .app-footer-brand img {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    box-shadow: 0 6px 14px rgba(26, 41, 71, .12);
  }

  .app-footer-brand strong {
    display: block;
    font-family: var(--display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.3;
  }

  .app-footer-brand small {
    display: block;
    max-width: 380px;
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .app-footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 20px;
    padding-top: 4px;
  }

  .app-footer-nav a {
    color: var(--muted);
    font-size: 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .app-footer-nav a:hover {
    color: var(--ink);
  }

  .app-footer-meta {
    display: flex;
    grid-column: 1 / -1;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    padding-top: 17px;
    border-top: 1px solid var(--line);
    color: var(--muted-light);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .app-footer-copy {
    margin-left: auto;
    text-transform: none;
    letter-spacing: .02em;
  }

  .app-footer-copy a {
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .app-header-inner {
      padding: 11px 18px 8px;
    }

    .app-brand {
      font-size: 16px;
    }

    .app-brand img {
      width: 29px;
      height: 29px;
    }

    .app-nav {
      gap: 18px;
      padding: 0 18px 9px;
    }

    .app-nav a {
      font-size: 11px;
    }

    .app-footer-inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 28px 18px 24px;
    }

    .app-footer-nav {
      justify-content: flex-start;
      gap: 8px 16px;
      padding-top: 0;
    }

    .app-footer-meta {
      margin-top: 8px;
    }

    .app-footer-copy {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
