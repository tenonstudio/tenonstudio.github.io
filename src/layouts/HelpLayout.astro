---
import BaseLayout from './BaseLayout.astro';
import Text from '../components/Text.astro';

interface Props {
  app: string;
  icon: string;
  title: { en: string; zh: string };
  lead: { en: string; zh: string };
  sections: { id: string; en: string; zh: string }[];
  backHref: string;
}
const { app, icon, title, lead, sections, backHref } = Astro.props;
---
<BaseLayout title={`${title.en} — Tenon Help`} description={lead.en} image={icon}>
  <div class="docs-shell shell">
    <aside class="docs-side">
      <a class="back-link" href={backHref}><span aria-hidden="true">←</span> <Text en={`Back to ${app}`} zh={`返回 ${app}`} /></a>
      <div class="docs-app-label">
        <img src={icon} alt="" width="30" height="30" />
        <span>{app}</span>
      </div>
      <nav class="docs-toc" aria-label="On this page">
        {sections.map((section) => (
          <a href={`#${section.id}`}><Text en={section.en} zh={section.zh} /></a>
        ))}
      </nav>
    </aside>
    <article class="docs-content">
      <p class="eyebrow"><Text en="Help" zh="帮助" /> / {app}</p>
      <h1><Text en={title.en} zh={title.zh} /></h1>
      <p class="docs-lead"><Text en={lead.en} zh={lead.zh} /></p>
      <slot />
      <div class="docs-footer">
        <a class="text-link" href={backHref}><span aria-hidden="true">←</span> <Text en={`Back to ${app}`} zh={`返回 ${app}`} /></a>
      </div>
    </article>
  </div>
</BaseLayout>
