---
import { apps } from '../data/apps';
import { SITE } from '../data/site';

const home = new URL('/', Astro.site);
const appSlugs = [...apps.map((app) => app.slug), 'porthole-for-chrome'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting — {SITE.name}</title>
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0; url=/" />
    <link rel="canonical" href={home} />
    <script is:inline define:vars={{ appSlugs }}>
      (() => {
        const parts = location.pathname.split('/').filter(Boolean);
        const slug = parts[0] === 'apps' ? parts[1] : null;
        const target = slug && appSlugs.includes(slug) ? `/apps/${slug}/` : '/';
        location.replace(target + location.search + location.hash);
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        margin: 0;
        background: #f9fafd;
        color: #1a2947;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
      }
      a {
        color: inherit;
        text-underline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <p>Redirecting to <a href="/">{SITE.name}</a>…</p>
  </body>
</html>
