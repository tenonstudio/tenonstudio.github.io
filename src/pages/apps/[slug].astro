---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/Text.astro';
import AppVisual from '../../components/AppVisual.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Specs from '../../components/Specs.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import DevelopmentPanel from '../../components/DevelopmentPanel.astro';
import RelatedApps from '../../components/RelatedApps.astro';
import { apps } from '../../data/apps';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
const inDevelopment = app.status === 'in-development';
const notifyHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`Notify me when ${app.name} is available`)}`;
---
<BaseLayout
  title={`${app.name} — ${SITE.shortName}`}
  description={`${app.name}: ${app.tagline.en}`}
  image={app.icon}
  current="apps"
>
  <article class="app-detail" style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}>
    <div class="shell">
      <a class="back-link" href="/#apps"><span aria-hidden="true">←</span> <Text en="All apps" zh="全部应用" /></a>
    </div>

    <header class="detail-hero shell">
      <div class="detail-copy">
        <p class="eyebrow">
          <span>{app.index}</span><span class="eyebrow-sep">/</span><Text en={app.category.en} zh={app.category.zh} />
          <span class="meta-platform">{app.platform}</span>
        </p>
        <div class="detail-title-row">
          <img class="detail-icon" src={app.icon} alt="" width="96" height="96" />
          <h1>{app.name}</h1>
        </div>
        <p class="detail-tagline"><Text en={app.tagline.en} zh={app.tagline.zh} /></p>
        <p class="detail-description"><Text en={app.description.en} zh={app.description.zh} /></p>
        <div class="detail-actions">
          {app.download ? (
            <a class="button button-dark" href={app.download}><Text en={`Download ${app.name}`} zh={`下载 ${app.name}`} /> <span aria-hidden="true">↓</span></a>
          ) : (
            <button class="button button-dark" type="button" disabled><Text en="Coming soon" zh="即将推出" /></button>
          )}
          {app.buy && <a class="text-link" href={app.buy}><Text en="License" zh="授权" /> <span aria-hidden="true">→</span></a>}
          {inDevelopment && <a class="text-link" href={notifyHref}><Text en="Get notified" zh="获取通知" /> <span aria-hidden="true">→</span></a>}
          {app.slug === 'porthole' && <a class="text-link" href="/apps/porthole-for-chrome/"><Text en="Chrome extension" zh="Chrome 扩展" /> <span aria-hidden="true">↗</span></a>}
          {(app.slug === 'flip' || app.slug === 'tessera') && <a class="text-link" href={`/apps/${app.slug}/help/`}><Text en="Scripting guide" zh="脚本指南" /> <span aria-hidden="true">→</span></a>}
        </div>
        <p class="detail-note">
          {inDevelopment
            ? <Text en={`In development · ${app.platform}`} zh={`开发中 · ${app.platform}`} />
            : app.free
              ? <Text en="Free · Universal · macOS" zh="免费 · Universal · macOS" />
              : <Text en="14-day trial · One-time purchase · macOS" zh="14 天试用 · 买断授权 · macOS" />}
        </p>
      </div>
      <AppVisual app={app} />
    </header>

    <FeatureGrid app={app} />
    {(app.slug === 'flip' || app.slug === 'tessera') && (
      <section class="doc-callout shell">
        <div>
          <p class="eyebrow"><Text en="Scripting guide" zh="脚本指南" /></p>
          <h2><Text en={app.slug === 'flip' ? 'Write your own Flip commands.' : 'Write your own Tessera wallpapers.'} zh={app.slug === 'flip' ? '写自己的 Flip 命令。' : '写自己的 Tessera 壁纸。'} /></h2>
        </div>
        <a class="button button-dark" href={`/apps/${app.slug}/help/`}><Text en="Read the guide" zh="阅读指南" /> <span aria-hidden="true">→</span></a>
      </section>
    )}
    <section class="shell"><Specs app={app} /></section>
    <div class="shell">
      {app.download ? <DownloadPanel app={app} /> : <DevelopmentPanel app={app} />}
    </div>
    <RelatedApps current={app.slug} />
  </article>
</BaseLayout>
