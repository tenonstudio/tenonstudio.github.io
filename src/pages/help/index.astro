---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/Text.astro';
---
<BaseLayout title="Help — Tenon" description="Guides for scripting Flip custom commands and Tessera wallpapers.">
  <section class="help-hero shell">
    <p class="eyebrow"><Text en="Help" zh="帮助" /></p>
    <h1><Text en="Make it yours." zh="把它变成你的。" /></h1>
    <p><Text en="Two scripting guides: Flip custom commands and Tessera wallpaper scripts. Both are local files, edited on your Mac." zh="两份脚本指南：Flip 自定义命令，以及 Tessera 壁纸脚本。两者都是本机文件，直接在你的 Mac 上编辑。" /></p>
  </section>
  <section class="help-grid shell">
    <a class="help-card" href="/help/flip/">
      <img src="/assets/flip-icon.png" alt="" width="64" height="64" />
      <div><span class="help-label">Flip</span><h2><Text en="Custom commands" zh="自定义命令" /></h2><p><Text en="Shell scripts that become switches, actions, or choice menus in your Flip panel." zh="让 shell 脚本变成 Flip 面板里的开关、一次性动作或选项菜单。" /></p></div>
      <span aria-hidden="true">→</span>
    </a>
    <a class="help-card" href="/help/tessera/">
      <img src="/assets/tessera-icon.png" alt="" width="64" height="64" />
      <div><span class="help-label">Tessera</span><h2><Text en="Wallpaper scripts" zh="壁纸脚本" /></h2><p><Text en="p5.js sketches with a small metadata header, running live behind your desktop." zh="带小型 metadata 头的 p5.js 草图，在桌面背后实时运行。" /></p></div>
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
