---
import HelpLayout from '../../layouts/HelpLayout.astro';
import Text from '../../components/Text.astro';

const sections = [
  { id: 'overview', en: 'Overview', zh: '概览' },
  { id: 'types', en: 'Command types', zh: '命令类型' },
  { id: 'environment', en: 'Environment contract', zh: '环境变量协议' },
  { id: 'toggle', en: 'Toggle example', zh: '开关示例' },
  { id: 'choice', en: 'Choice example', zh: '选项示例' },
  { id: 'action', en: 'Action example', zh: '一次性动作' },
  { id: 'interpreter', en: 'Interpreter and PATH', zh: '解释器与 PATH' },
  { id: 'sharing', en: 'Import, export, signing', zh: '导入、导出与签名' },
  { id: 'troubleshooting', en: 'Troubleshooting', zh: '排查' }
];
---
<HelpLayout
  app="Flip"
  icon="/assets/flip-icon.png"
  title={{ en: 'Flip custom commands', zh: 'Flip 自定义命令' }}
  lead={{
    en: 'Turn a local shell script into a switch, a one-shot action, or a choice menu in your Flip panel. No account, no server, no App Store review.',
    zh: '把一个本地 shell 脚本变成 Flip 面板里的开关、一次性动作或选项菜单。不需要账号、服务器或 App Store 审核。'
  }}
  sections={sections}
>
  <section id="overview">
    <h2><Text en="Overview" zh="概览" /></h2>
    <p><Text en="Flip runs each custom command as a normal process under your user account. The first line of the script chooses the interpreter; without a shebang, Flip uses /bin/zsh." zh="Flip 以当前用户身份运行每个自定义命令。脚本第一行决定解释器；没有 shebang 时使用 /bin/zsh。" /></p>
    <p><Text en="Create a command in Flip → Settings → Custom. The script is saved at ~/.config/flip/commands/&lt;uuid&gt;.sh. Edit it in Flip's editor or in an external editor." zh="在 Flip → 设置 → 自定义 中新建命令。脚本保存在 ~/.config/flip/commands/&lt;uuid&gt;.sh，可以在 Flip 编辑器或外部编辑器中修改。" /></p>
    <div class="doc-note"><Text en="Custom commands are shell scripts, not JavaScript. Tessera wallpaper scripts are a separate format — see the Tessera guide." zh="自定义命令是 shell 脚本，不是 JavaScript。Tessera 壁纸脚本是另一套格式——请查看 Tessera 指南。" /></div>
  </section>

  <section id="types">
    <h2><Text en="Command types" zh="命令类型" /></h2>
    <ul>
      <li><strong><Text en="Action" zh="一次性动作" /></strong> — <Text en="runs once and has no persisted state. FLIP_ACTION is run." zh="只执行一次，不保存状态。FLIP_ACTION 为 run。" /></li>
      <li><strong><Text en="Toggle" zh="开关" /></strong> — <Text en="has a current on/off value. Flip calls state, then on or off." zh="有当前开/关状态。Flip 调用 state，然后调用 on 或 off。" /></li>
      <li><strong><Text en="Choice" zh="选项" /></strong> — <Text en="has preset options. Flip calls set with FLIP_CHOICE set to the selected option id." zh="有预设选项。用户选择后 Flip 调用 set，并通过 FLIP_CHOICE 传入选项 id。" /></li>
    </ul>
    <p><Text en="Options are defined in the editor. Scripts cannot generate options dynamically." zh="选项在编辑器中预设，脚本不能动态生成选项。" /></p>
  </section>

  <section id="environment">
    <h2><Text en="Environment contract" zh="环境变量协议" /></h2>
    <div class="doc-table-wrap"><table class="doc-table">
      <thead><tr><th><Text en="Variable" zh="变量" /></th><th><Text en="Meaning" zh="含义" /></th></tr></thead>
      <tbody>
        <tr><td><code>FLIP_ACTION</code></td><td><Text en="state, on, off, run, or set" zh="state、on、off、run 或 set" /></td></tr>
        <tr><td><code>FLIP_CHOICE</code></td><td><Text en="Selected option id when FLIP_ACTION=set" zh="FLIP_ACTION=set 时选中的选项 id" /></td></tr>
        <tr><td><code>FLIP_STATE_DIR</code></td><td><Text en="Per-command state directory (created for you)" zh="每个命令独立的状态目录（已创建）" /></td></tr>
        <tr><td><code>FLIP_COMMAND_ID</code></td><td><Text en="Stable command UUID" zh="命令的固定 UUID" /></td></tr>
      </tbody>
    </table></div>
  </section>

  <section id="toggle">
    <h2><Text en="Toggle example" zh="开关示例" /></h2>
    <p><Text en="A toggle must answer state with one of on, off, true, false, 1, or 0. Save state in FLIP_STATE_DIR or read the real system state." zh="开关的 state 必须输出 on、off、true、false、1 或 0。状态可以保存在 FLIP_STATE_DIR，也可以读取真实系统状态。" /></p>
    <pre><code>{`#!/bin/zsh
case "$FLIP_ACTION" in
  state)
    if [[ -f "$FLIP_STATE_DIR/on" ]]; then
      echo on
    else
      echo off
    fi
    ;;
  on)
    touch "$FLIP_STATE_DIR/on"
    ;;
  off)
    rm -f "$FLIP_STATE_DIR/on"
    ;;
esac`}</code></pre>
    <p><Text en="If state fails, Flip falls back to its local value and marks the row as using local state. That can drift from the real system state, so returning an explicit state is recommended." zh="如果 state 失败，Flip 会回退到本地值，并标记为“本地状态”。这可能与真实系统状态不同，建议始终返回明确状态。" /></p>
  </section>

  <section id="choice">
    <h2><Text en="Choice example" zh="选项示例" /></h2>
    <p><Text en="Define options in the editor, then handle set. FLIP_CHOICE contains the id, not the display title." zh="先在编辑器中定义选项，再处理 set。FLIP_CHOICE 是选项 id，不是显示名称。" /></p>
    <pre><code>{`#!/bin/zsh
case "$FLIP_ACTION" in
  set)
    case "$FLIP_CHOICE" in
      compact) echo "Compact desktop" ;;
      focus)   echo "Focus mode" ;;
      present) echo "Presentation mode" ;;
    esac
    ;;
  state)
    cat "$FLIP_STATE_DIR/current" 2>/dev/null || echo "compact"
    ;;
esac`}</code></pre>
  </section>

  <section id="action">
    <h2><Text en="Action example" zh="一次性动作" /></h2>
    <p><Text en="An action only needs the run branch. stdout is shown in the HUD after execution; state/on/off/set stdout is protocol data and is not shown." zh="一次性动作只需要 run 分支。执行后 stdout 会显示在 HUD；state/on/off/set 的 stdout 是协议数据，不会显示。" /></p>
    <pre><code>{`#!/bin/zsh
case "$FLIP_ACTION" in
  run)
    echo "Cleaning temporary files…"
    rm -rf "$HOME/Library/Caches/example-app"/*
    echo "Done"
    ;;
esac`}</code></pre>
  </section>

  <section id="interpreter">
    <h2><Text en="Interpreter and PATH" zh="解释器与 PATH" /></h2>
    <p><Text en="Use a shebang to choose Ruby, Python, or any installed interpreter. Homebrew paths and common user bin directories are added to PATH automatically." zh="用 shebang 选择 Ruby、Python 或任意已安装解释器。Homebrew 路径和常见用户 bin 目录会自动加入 PATH。" /></p>
    <pre><code>{`#!/usr/bin/env python3
import os
print("Flip says hello")`}</code></pre>
    <p><Text en="sudo, AppleScript's “with administrator privileges”, and AuthorizationExecuteWithPrivileges are rejected. Privileged controls must use the System Helper, not a custom command." zh="脚本中的 sudo、AppleScript 的“以管理员权限运行”以及 AuthorizationExecuteWithPrivileges 会被拒绝。需要特权的控制应使用 System Helper，而不是自定义命令。" /></p>
  </section>

  <section id="sharing">
    <h2><Text en="Import, export, signing" zh="导入、导出与签名" /></h2>
    <p><Text en="Use Settings → Custom to export .json or import a shared command. Unsigned imports are allowed after confirmation and start disabled. Signed imports verify with Flip's built-in Ed25519 public key; an invalid signature is rejected." zh="在 设置 → 自定义 中导出 .json 或导入共享命令。未签名导入在确认后允许，导入后默认停用。签名导入会用 Flip 内置 Ed25519 公钥验证；签名无效会被拒绝。" /></p>
    <p><Text en="Local commands do not need a signature. Signing only proves distribution origin and integrity; it does not grant additional permissions." zh="本机创建的命令不需要签名。签名只证明分发来源和完整性，不会授予额外权限。" /></p>
    <pre><code>{`{
  "schema": 1,
  "payload": "<base64 JSON>",
  "signature": null,
  "signer": null
}`}</code></pre>
  </section>

  <section id="troubleshooting">
    <h2><Text en="Troubleshooting" zh="排查" /></h2>
    <ul>
      <li><Text en="No HUD output: make sure the action uses the run branch and prints to stdout." zh="没有 HUD 输出：确认动作使用 run 分支，并向 stdout 输出。" /></li>
      <li><Text en="Toggle snaps back: return a valid state value and avoid mixing cached and real system state." zh="开关回弹：返回合法 state，避免混用缓存和真实系统状态。" /></li>
      <li><Text en="Command not found: use an absolute path or a Homebrew-installed command; check PATH." zh="找不到命令：使用绝对路径或 Homebrew 命令，并检查 PATH。" /></li>
      <li><Text en="Permission denied: chmod +x the script, or make sure the interpreter path is valid." zh="Permission denied：给脚本 chmod +x，或确认解释器路径有效。" /></li>
      <li><Text en="Changes not visible: reopen the Flip panel or settings page to reload the script." zh="修改不可见：重新打开 Flip 面板或设置页以重新加载脚本。" /></li>
    </ul>
  </section>
</HelpLayout>
