---
import HomeLayout from '../layouts/HomeLayout.astro';
import Text from '../components/Text.astro';
import TesseraPattern from '../components/home/TesseraPattern.astro';
import LaunchpadMock from '../components/home/LaunchpadMock.astro';
import MacIconCloud from '../components/home/MacIconCloud.astro';
import PortholeVisual from '../components/home/PortholeVisual.astro';
import BubbleVisual from '../components/home/BubbleVisual.astro';
import WorkshopVisual from '../components/home/WorkshopVisual.astro';
import { homeMeta, work, contacts } from '../data/home';
import { apps } from '../data/apps';
import { SITE } from '../data/site';

const year = new Date().getFullYear();
const workshopApps = apps.filter((app) => app.status === 'in-development');
const contactIcons = {
  email: '/assets/home/email.svg',
  github: '/assets/home/github.svg',
  x: '/assets/home/x.svg'
} as const;
---
<HomeLayout
  title={homeMeta.title}
  titleZh={homeMeta.titleZh}
  description={homeMeta.description}
  descriptionZh={homeMeta.descriptionZh}
>
  <div class="container">
    <header class="header">
      <div class="header-content">
        <h1 class="company-name">
          <Text en={SITE.name.toUpperCase()} zh={SITE.nameZh} />
        </h1>
        <a
          class="social-handle"
          href={SITE.x.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Tenon Studio on X"
        >
          <img class="at-symbol" src="/assets/home/at.svg" alt="" width="16" height="16" />
          <span>{SITE.x.handle}</span>
        </a>
      </div>
      <a class="logo" href="/" aria-label="Tenon Studio home">
        <img
          class="logo-img"
          src="/assets/brand/tenon-avatar-128.png?v=tenon"
          alt="Tenon Studio"
          width="48"
          height="48"
        />
      </a>
    </header>

    <main id="main">
      <section class="hero" id="studio" aria-label="About Tenon Studio">
        <div class="hero-content-greeting">
          <p class="greeting">
            <Text en={homeMeta.greeting} zh={homeMeta.greetingZh} />
          </p>
          <div class="waving-hand" aria-hidden="true">
            <img class="hand-icon" src="/assets/home/hand.svg" alt="" width="16" height="16" />
          </div>
        </div>

        <p class="description">
          <Text en={homeMeta.intro} zh={homeMeta.introZh} />
        </p>

        <div class="cta-section">
          <p class="cta-text">
            <Text en={homeMeta.ctaLead} zh={homeMeta.ctaLeadZh} class="cta-lead" /><a href="#contact" class="cta-container">
              <span class="mail-capsule">
                <img class="mail-icon" src="/assets/home/mail.svg" alt="" width="16" height="16" />
              </span>
              <Text en={homeMeta.ctaLink} zh={homeMeta.ctaLinkZh} tag="span" class="cta-link" />
            </a>
          </p>
          <p class="copy-instruction">
            <Text en={homeMeta.copyPress} zh={homeMeta.copyPressZh} />
            <button
              class="copy-btn"
              type="button"
              data-copy-email={SITE.email}
              aria-label="Copy our email address"
              data-aria-en="Copy our email address"
              data-aria-zh="复制我们的邮箱地址"
            >
              c
            </button>
            <Text en={homeMeta.copyHint} zh={homeMeta.copyHintZh} />
          </p>
        </div>
      </section>

      <section class="work-section" id="apps" aria-labelledby="work-title">
        <div class="section-header">
          <h2 class="section-title" id="work-title">
            <Text en={homeMeta.workTitle} zh={homeMeta.workTitleZh} />
          </h2>
          <p class="section-subtitle">
            <Text en={homeMeta.workSubtitle} zh={homeMeta.workSubtitleZh} />
          </p>
        </div>

        <div class="projects-grid">
          <a class="project-card flip-card" href={work.flip.href}>
            <div class="card-content">
              <div class="project-icon">
                <img src="/assets/flip-icon.png" alt="" width="36" height="36" />
              </div>
              <h3 class="project-title">
                <Text en={work.flip.title} zh={work.flip.titleZh} />
              </h3>
              <div class="project-tags">
                <span class="tag">{work.flip.tags[0]}</span>
              </div>
            </div>
            <div class="card-visual flip-visual" aria-hidden="true">
              <img
                class="flip-panel-shot"
                src="/assets/screenshots/flip-panel.png"
                alt=""
                width="680"
                height="1332"
              />
            </div>
          </a>

          <a class="project-card tessera-card" href={work.tessera.href}>
            <div class="card-content">
              <div class="project-icon">
                <img src="/assets/tessera-icon.png" alt="" width="36" height="36" />
              </div>
              <h3 class="project-title">
                <Text en={work.tessera.title} zh={work.tessera.titleZh} />
              </h3>
              <div class="project-tags">
                <span class="tag">{work.tessera.tags[0]}</span>
              </div>
            </div>
            <div class="card-visual tessera-visual" aria-hidden="true">
              <TesseraPattern />
            </div>
          </a>

          <div class="launchpad-wrap">
            <MacIconCloud />
            <a class="project-card launchpad-card" href={work.launchpad.href}>
              <div class="card-content">
                <div class="project-icon">
                  <img src="/assets/launchpad-icon.png" alt="" width="36" height="36" />
                </div>
                <h3 class="project-title">
                  <Text en={work.launchpad.title} zh={work.launchpad.titleZh} />
                </h3>
                <div class="project-tags">
                  <span class="tag">{work.launchpad.tags[0]}</span>
                </div>
              </div>
              <div class="card-visual launchpad-visual" aria-hidden="true">
                <LaunchpadMock />
              </div>
            </a>
          </div>

          <a class="project-card porthole-card" href={work.porthole.href}>
            <div class="card-content">
              <div class="project-icon">
                <img src="/assets/porthole-icon.png" alt="" width="36" height="36" />
              </div>
              <h3 class="project-title">
                <Text en={work.porthole.title} zh={work.porthole.titleZh} />
              </h3>
              <div class="project-tags">
                <span class="tag">{work.porthole.tags[0]}</span>
              </div>
            </div>
            <div class="card-visual" aria-hidden="true">
              <PortholeVisual />
            </div>
          </a>

          <a class="project-card bubble-card" href={work.bubble.href}>
            <div class="card-content">
              <div class="project-icon">
                <img src="/assets/bubble-icon.png" alt="" width="36" height="36" />
              </div>
              <h3 class="project-title">
                <Text en={work.bubble.title} zh={work.bubble.titleZh} />
              </h3>
              <div class="project-tags">
                <span class="tag">{work.bubble.tags[0]}</span>
              </div>
            </div>
            <div class="card-visual" aria-hidden="true">
              <BubbleVisual />
            </div>
          </a>

          <a class="project-card crate-card" href={work.crate.href}>
            <div class="card-content">
              <div class="project-icon">
                <img src="/assets/crate-icon.png" alt="" width="36" height="36" />
              </div>
              <h3 class="project-title">
                <Text en={work.crate.title} zh={work.crate.titleZh} />
              </h3>
              <div class="project-tags">
                <span class="tag">{work.crate.tags[0]}</span>
              </div>
            </div>
            <div class="card-visual crate-visual" aria-hidden="true">
              <img class="crate-home-shot" src="/assets/screenshots/crate-main.png" alt="" width="640" height="420" />
            </div>
          </a>
        </div>
      </section>

      <section class="workshop-section" id="workshop" aria-labelledby="workshop-title">
        <div class="section-header">
          <h2 class="section-title" id="workshop-title">
            <Text en={homeMeta.workshopTitle} zh={homeMeta.workshopTitleZh} />
          </h2>
          <p class="section-subtitle">
            <Text en={homeMeta.workshopSubtitle} zh={homeMeta.workshopSubtitleZh} />
          </p>
        </div>

        <div class="projects-grid workshop-grid">
          {workshopApps.map((app) => (
            <a
              class={`project-card workshop-card ${app.slug}-card`}
              href={`/apps/${app.slug}/`}
              style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}
            >
              <div class="card-content">
                <div class="project-icon">
                  <img src={app.icon} alt="" width="36" height="36" decoding="async" />
                </div>
                <h3 class="project-title">
                  <Text en={`${app.name} - ${app.category.en}`} zh={`${app.name} - ${app.category.zh}`} />
                </h3>
                <div class="project-tags">
                  <span class="tag">{app.platform}</span>
                  <span class="badge workshop-badge"><Text en="In development" zh="开发中" /></span>
                </div>
              </div>
              <div class={`card-visual ${app.slug}-visual`} aria-hidden="true">
                <WorkshopVisual app={app} />
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-header">
          <h2 class="section-title" id="contact-title">
            <Text en={homeMeta.contactTitle} zh={homeMeta.contactTitleZh} />
          </h2>
          <p class="section-subtitle">
            <Text en={homeMeta.contactSubtitle} zh={homeMeta.contactSubtitleZh} />
          </p>
        </div>

        <div class="contact-grid">
          {contacts.map((contact) =>
            'copy' in contact ? (
              <button
                class="contact-item contact-item--button"
                type="button"
                data-copy-email={SITE.email}
                aria-label={`Copy our email address, ${SITE.email}`}
                data-aria-en={`Copy our email address, ${SITE.email}`}
                data-aria-zh={`复制邮箱地址，${SITE.email}`}
              >
                <img class="contact-icon" src={contactIcons[contact.kind]} alt="" width="24" height="24" />
                <span class="contact-label">
                  <Text en={contact.label} zh={contact.labelZh} />
                </span>
                <span class="contact-value">{contact.value}</span>
                <img class="arrow-icon" src="/assets/home/arrow.svg" alt="" width="16" height="16" />
              </button>
            ) : (
              <a class="contact-item" href={contact.href} target="_blank" rel="noopener noreferrer">
                <img class="contact-icon" src={contactIcons[contact.kind]} alt="" width="24" height="24" />
                <span class="contact-label">
                  <Text en={contact.label} zh={contact.labelZh} />
                </span>
                <span class="contact-value">{contact.value}</span>
                <img class="arrow-icon" src="/assets/home/arrow.svg" alt="" width="16" height="16" />
              </a>
            )
          )}
        </div>
      </section>
    </main>

    <footer class="footer">
      <p class="footer-text">
        © {year} <Text en={SITE.name} zh={SITE.nameZh} />
      </p>
    </footer>
  </div>

  <script>
    const email = document.querySelector<HTMLElement>('[data-copy-email]')?.dataset.copyEmail ?? '';
    const isZh = () => document.documentElement.dataset.lang === 'zh';

    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.innerHTML = `
      <svg class="toast-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13.5 4.5 6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="toast-text"></span>
    `;
    document.body.appendChild(toast);

    const toastText = toast.querySelector<HTMLElement>('.toast-text');
    let toastTimer = 0;

    function showToast(message: string) {
      if (!toastText) return;
      toastText.textContent = message;
      toast.classList.add('is-visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2800);
    }

    function fallbackCopy(text: string) {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.left = '-9999px';
      area.style.top = '0';
      document.body.appendChild(area);
      area.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }
      document.body.removeChild(area);
      return copied;
    }

    async function copyEmail() {
      if (!email) return;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(email);
          showToast(isZh() ? '邮箱已复制！' : 'Email copied!');
          return;
        }
        throw new Error('Clipboard API unavailable');
      } catch {
        if (fallbackCopy(email)) {
          showToast(isZh() ? '邮箱已复制！' : 'Email copied!');
        } else {
          showToast(isZh() ? `复制失败 — ${email}` : `Copy failed — ${email}`);
        }
      }
    }

    document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((button) => {
      button.addEventListener('click', () => {
        void copyEmail();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key.toLowerCase() !== 'c') return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;

      const active = document.activeElement as HTMLElement | null;
      if (active?.matches('input, textarea, select, [contenteditable="true"]')) return;
      if (window.getSelection()?.toString().length) return;

      event.preventDefault();
      void copyEmail();
    });
  </script>
</HomeLayout>
