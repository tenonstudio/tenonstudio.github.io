---
import BaseLayout from '../layouts/BaseLayout.astro';
import Text from '../components/Text.astro';
import { apps } from '../data/apps';

const copy = {
  flip: {
    en: 'Low power, dark mode, keep awake, cleanup, Focus, and your own commands — one quiet panel for the Mac.',
    zh: '低电量、深色模式、保持唤醒、清理、专注，以及你自己的命令——一个安静的 Mac 面板。'
  },
  porthole: {
    en: 'Turn any window or screen region into a real-time floating mirror. Keep a chart, chat, or reference in sight.',
    zh: '把任意窗口或屏幕区域变成实时悬浮镜像。行情、聊天或参考资料，一直留在视线里。'
  },
  tessera: {
    en: 'Generative p5.js sketches that live behind your desktop. Pick a theme, or open the source and make it yours.',
    zh: '运行在桌面背后的 p5.js 生成艺术。选一个主题，或者打开源码改成自己的。'
  }
} as const;
---
<BaseLayout
  title="Tenon — Small software for macOS"
  description="Tenon is an independent software studio making small, precise tools for macOS: Flip, Porthole, and Tessera."
>
  <section class="home-intro shell">
    <p class="eyebrow"><span class="eyebrow-dot"></span><Text en="Independent software studio" zh="独立软件工作室" /></p>
    <h1><Text en="Small software, made to fit." zh="小而精确的软件，刚好合上。" /></h1>
    <p class="hero-lead"><Text en="Quiet tools for macOS. No dashboards, no accounts — just the things you actually reach for, built with care." zh="为 macOS 做的安静工具。没有仪表盘，没有账号——只有你每天真的会用到的东西，认真做。" /></p>
  </section>

  <section class="product-stack shell" id="apps">
    {apps.map((app) => (
      <article class:list={['product-banner', `banner-${app.slug}`]} style={`--app-accent:${app.accent};`}>
        <div class="banner-art" aria-hidden="true">
          <span class="banner-glow"></span>
          <img src={app.icon} alt="" width="220" height="220" loading="eager" />
        </div>
        <div class="banner-copy">
          <p class="banner-category"><span>{app.index}</span> / <Text en={app.category.en} zh={app.category.zh} /> <span class="banner-platform">{app.platform}</span></p>
          <h2>{app.name}</h2>
          <p class="banner-tagline"><Text en={app.tagline.en} zh={app.tagline.zh} /></p>
          <p class="banner-body"><Text en={copy[app.slug as keyof typeof copy].en} zh={copy[app.slug as keyof typeof copy].zh} /></p>
          <div class="banner-actions">
            <a class="banner-button" href={`/apps/${app.slug}/`}><Text en="Learn more" zh="了解更多" /> <span aria-hidden="true">→</span></a>
            <a class="banner-button banner-button-quiet" href={app.download}><Text en="Download" zh="下载" /> <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="studio-band" id="studio">
    <div class="shell studio-inner">
      <p class="eyebrow eyebrow-light"><Text en="Tenon" zh="榫卯" /></p>
      <blockquote>
        <span data-lang="en">A small joint.<br /><em>Quiet software.</em></span>
        <span data-lang="zh">一个小小的榫，<br /><em>一种安静的软件。</em></span>
      </blockquote>
      <div class="studio-copy">
        <p><Text en="A tenon joins two pieces of wood without a nail. No noise, no excess — it simply fits. That is the kind of software we want to make: small, precise, and content to stay out of your way." zh="榫，是让两块木头不用钉子也能咬合的小结构。没有噪音，没有多余——只是刚好合上。我们想做这样的软件：小而精确，安静地不挡路。" /></p>
        <p class="studio-note"><Text en="Tenon is an independent studio led by Tao Wang, making careful tools for the Mac since 2024." zh="Tenon 榫卯是由 Tao Wang 主理的独立工作室，从 2024 年开始做认真的 Mac 工具。" /></p>
      </div>
      <div class="studio-values">
        <div><span>01</span><h3><Text en="Precise" zh="精确" /></h3><p><Text en="One job, done properly." zh="一件事，认真做。" /></p></div>
        <div><span>02</span><h3><Text en="Quiet" zh="安静" /></h3><p><Text en="Present only when needed." zh="需要时出现，做完就退后。" /></p></div>
        <div><span>03</span><h3><Text en="Useful" zh="有用" /></h3><p><Text en="Every switch earns its place." zh="每个开关都有存在的理由。" /></p></div>
      </div>
    </div>
  </section>

  <section class="closing shell">
    <p class="eyebrow"><Text en="More parts, fitting together" zh="还有更多零件，正在合上" /></p>
    <h2><Text en="There is more on the bench." zh="工作台上，还有更多。" /></h2>
    <p><Text en="New tools are being fitted together. In the meantime, make one of the existing apps part of your day." zh="新的工具正在合上。在那之前，先让现有的 App 融进你的一天。" /></p>
    <a class="text-link" href="#apps"><Text en="Back to the apps" zh="回到应用" /> <span aria-hidden="true">↑</span></a>
  </section>
</BaseLayout>
