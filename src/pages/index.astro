---
import BaseLayout from '../layouts/BaseLayout.astro';
import Text from '../components/Text.astro';
import AppVisual from '../components/AppVisual.astro';
import { apps } from '../data/apps';

const flipImage = '/assets/screenshots/flip-settings.png';
---
<BaseLayout
  title="Tenon — Small software for macOS"
  description="Three small, precise macOS tools from Tenon: Flip, Porthole, and Tessera."
>
  <section class="studio-hero shell">
    <p class="eyebrow"><span class="eyebrow-dot"></span><Text en="Independent software studio" zh="独立软件工作室" /></p>
    <h1><Text en="Three small tools." zh="三件小工具。" /><br /><em><Text en="One quieter Mac." zh="一台更安静的 Mac。" /></em></h1>
    <p class="studio-hero-lead"><Text en="Flip, Porthole, and Tessera. Three focused apps for the things a Mac should do without getting in the way." zh="Flip、Porthole 和 Tessera。三个专注的 App，让 Mac 做好该做的事，同时不挡路。" /></p>
    <div class="app-index">
      {apps.map((app) => (
        <a class="app-index-card" href={`/apps/${app.slug}/`} style={`--app-accent:${app.accent};`}>
          <img src={app.icon} alt="" width="58" height="58" />
          <span class="app-index-copy">
            <b>{app.name}</b>
            <small><Text en={app.category.en} zh={app.category.zh} /></small>
          </span>
          <span class="app-index-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <div class="showcase-list shell">
    {apps.map((app, index) => (
      <article class:list={['showcase', { 'showcase-reverse': index % 2 === 1 }]} style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}>
        <header class="showcase-head">
          <div class="showcase-title">
            <img src={app.icon} alt="" width="88" height="88" />
            <div>
              <p class="showcase-meta"><span>{app.index}</span> / <Text en={app.category.en} zh={app.category.zh} /> <span class="showcase-platform">{app.platform}</span></p>
              <h2>{app.name}</h2>
            </div>
          </div>
          <p class="showcase-tagline"><Text en={app.tagline.en} zh={app.tagline.zh} /></p>
        </header>
        <div class="showcase-body">
          <div class="showcase-copy">
            <p class="showcase-description"><Text en={app.description.en} zh={app.description.zh} /></p>
            <ul class="showcase-features">
              {app.features.slice(0, 3).map((feature) => (
                <li>
                  <b><Text en={feature.title.en} zh={feature.title.zh} /></b>
                  <span><Text en={feature.body.en} zh={feature.body.zh} /></span>
                </li>
              ))}
            </ul>
            <div class="showcase-actions">
              <a class="button button-dark" href={`/apps/${app.slug}/`}><Text en={`Explore ${app.name}`} zh={`了解 ${app.name}`} /> <span aria-hidden="true">→</span></a>
              <a class="text-link" href={app.download}><Text en="Download" zh="下载" /> <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="showcase-visual">
            {app.slug === 'flip' ? (
              <img class="showcase-photo" src={flipImage} alt="Flip settings" width="1200" height="960" loading="lazy" />
            ) : (
              <AppVisual app={app} />
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <section class="studio-mini shell" id="studio">
    <p class="eyebrow"><Text en="Tenon" zh="榫卯" /></p>
    <h2><Text en="Small, precise software — made to fit." zh="小而精确的软件，刚好合上。" /></h2>
    <p><Text en="Tenon is an independent studio making careful tools for the Mac. No dashboards, no accounts, no noise — just the things you actually reach for." zh="Tenon 榫卯是一家独立工作室，为 Mac 做认真的工具。没有仪表盘，没有账号，没有噪音——只有你每天真的会用到的东西。" /></p>
  </section>
</BaseLayout>
