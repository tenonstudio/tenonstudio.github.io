---
import Text from './Text.astro';
const { current } = Astro.props;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Tenon">
      <img class="brand-mark" src="/assets/brand/tenon-avatar-64.png" alt="" width="30" height="30" />
      <span class="brand-name">tenon</span>
      <span class="brand-cn">榫卯</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/#apps" class:list={{ active: current === 'apps' }}>
        <Text en="Apps" zh="应用" />
      </a>
      <a href="/#studio" class:list={{ active: current === 'studio' }}>
        <Text en="Studio" zh="工作室" />
      </a>
      <a href="/help/" class:list={{ active: current === 'help' }}>
        <Text en="Help" zh="帮助" />
      </a>
    </nav>
    <div class="lang-switch" role="group" aria-label="Language">
      <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-set-lang="zh" aria-pressed="false">中</button>
    </div>
  </div>
</header>
