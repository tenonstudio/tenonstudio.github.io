---
import Text from './Text.astro';
import { SITE } from '../data/site';
const { current } = Astro.props;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={SITE.name}>
      <img class="brand-mark" src="/assets/brand/tenon-avatar-64.png" alt="" width="30" height="30" />
      <span class="brand-name">{SITE.brand}</span>
      <span class="brand-cn">{SITE.nameZh}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/#apps" class:list={{ active: current === 'apps' }}>
        <Text en="Apps" zh="应用" />
      </a>
      <a href="/#studio" class:list={{ active: current === 'studio' }}>
        <Text en="Studio" zh="工坊" />
      </a>
    </nav>
  </div>
</header>
