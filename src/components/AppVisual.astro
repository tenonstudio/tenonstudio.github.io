---
import type { App } from '../data/apps';
import Text from './Text.astro';
const { app } = Astro.props as { app: App };
---
<div class:list={['app-art', `app-art-${app.slug}`]} style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`} aria-hidden="true">
  <div class="app-art-glow"></div>
  {app.slug === 'flip' && (
    <div class="flip-shell">
      <div class="flip-bar"><span class="traffic"><i></i><i></i><i></i></span><span>Flip</span><span class="flip-bar-menu">•••</span></div>
      <div class="flip-line"><span class="flip-line-icon">◐</span><div><b>Dark mode</b><small>Manual</small></div><span class="toggle on"></span></div>
      <div class="flip-line"><span class="flip-line-icon">✦</span><div><b>Keep awake</b><small>Indefinitely</small></div><span class="toggle on"></span></div>
      <div class="flip-line"><span class="flip-line-icon">▦</span><div><b>Hide desktop</b><small>Clean space</small></div><span class="toggle"></span></div>
      <div class="flip-line"><span class="flip-line-icon">◌</span><div><b>Mute mic</b><small>Input muted</small></div><span class="toggle"></span></div>
    </div>
  )}
  {app.slug === 'bubble' && (
    <div class="bubble-demo">
      <div class="bubble-selected">We selected <mark>this sentence</mark> right here.</div>
      <div class="bubble-bar">
        <span class="bubble-search">⌕</span>
        <span>Cut</span>
        <span>Copy</span>
        <span class="bubble-active">Paste</span>
        <span class="bubble-more">•••</span>
      </div>
    </div>
  )}
  {app.slug === 'porthole' && (
    <div class="porthole-layers">
      <div class="porthole-back"><span class="porthole-dot"></span><span class="porthole-line"></span><span class="porthole-line short"></span></div>
      <div class="porthole-mirror">
        <span class="porthole-window-title"><i></i><i></i><i></i> Live window</span>
        <div class="porthole-chart"><span></span><span></span><span></span><span></span><span></span></div>
        <span class="porthole-source">source · 60 fps</span>
      </div>
      <span class="porthole-label"><Text en="Click-through" zh="点击穿透" /></span>
    </div>
  )}
  {app.slug === 'crate' && (
    <img class="crate-app-shot" src="/assets/screenshots/crate-main.png" alt="" width="640" height="420" />
  )}
  {app.slug === 'clippet' && (
    <div class="clippet-window">
      <div class="clippet-top">
        <span class="clippet-search"><span class="clippet-lens">⌕</span><span>invoice</span></span>
        <span class="clippet-tab is-on">Clipboard</span>
        <span class="clippet-tab">Images</span>
      </div>
      <div class="clippet-grid">
        <div class="clippet-card is-active">
          <span class="clippet-card-top"><span>Text</span><span class="clippet-key">1</span></span>
          <p>struct Clip: Identifiable &#123;<br />  let id: UUID<br />  let title: String<br />&#125;</p>
          <small>87 characters</small>
        </div>
        <div class="clippet-card">
          <span class="clippet-card-top"><span>Image</span><span class="clippet-key">2</span></span>
          <span class="clippet-thumb">INVOICE</span>
          <small>OCR · 64 characters</small>
        </div>
        <div class="clippet-card">
          <span class="clippet-card-top"><span>Color</span><span class="clippet-key">3</span></span>
          <span class="clippet-swatch">#FF9F1A</span>
          <small>rgb(255, 159, 26)</small>
        </div>
        <div class="clippet-card">
          <span class="clippet-card-top"><span>Link</span><span class="clippet-key">4</span></span>
          <p>developer.apple.com/design</p>
          <small>Working Set</small>
        </div>
      </div>
    </div>
    <span class="clippet-shortcut">⌃⌘V</span>
  )}
  {app.slug === 'clutch' && (
    <div class="clutch-stage">
      <span class="clutch-corner tl"></span>
      <span class="clutch-corner tr"></span>
      <span class="clutch-corner bl"></span>
      <span class="clutch-corner br"></span>
      <svg class="clutch-trail" viewBox="0 0 320 320" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="clutch-trail-gradient" x1="64" y1="252" x2="246" y2="62" gradientUnits="userSpaceOnUse">
            <stop stop-color="#8fc0ff" />
            <stop offset="1" stop-color="#2f7cf6" />
          </linearGradient>
        </defs>
        <path d="M64 252C92 212 94 152 138 128S222 102 246 62" stroke="url(#clutch-trail-gradient)" stroke-width="9" stroke-linecap="round" />
        <path d="M226 66L250 58L244 84" stroke="#2f7cf6" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="64" cy="252" r="6" fill="#3b8cff" />
      </svg>
      <span class="clutch-hud">↑ Mission Control</span>
      <span class="clutch-hint">Hold right button · draw</span>
    </div>
  )}
  {app.slug === 'follow' && (
    <div class="follow-phone">
      <span class="follow-island"></span>
      <div class="follow-top"><span>My Channels</span><span class="follow-top-add">＋</span></div>
      <div class="follow-total">
        <small>ALL FOLLOWERS</small>
        <strong>48,209</strong>
        <span class="follow-delta">↑ 2.4%</span>
      </div>
      <div class="follow-bars" aria-hidden="true">
        <i style="--h:32%"></i><i style="--h:44%"></i><i style="--h:38%"></i><i style="--h:57%"></i>
        <i style="--h:51%"></i><i style="--h:68%"></i><i style="--h:78%"></i><i style="--h:92%"></i>
      </div>
      <div class="follow-list">
        <div class="follow-row">
          <span class="follow-avatar gh">GH</span>
          <span class="follow-site"><b>GitHub</b><small>@tenonstudio</small></span>
          <strong>12.4k</strong>
        </div>
        <div class="follow-row">
          <span class="follow-avatar yt">YT</span>
          <span class="follow-site"><b>YouTube</b><small>@tenonstudio</small></span>
          <strong>8.2k</strong>
        </div>
        <div class="follow-row">
          <span class="follow-avatar ig">IG</span>
          <span class="follow-site"><b>Instagram</b><small>@tenon.studio</small></span>
          <strong>21.7k</strong>
        </div>
      </div>
      <div class="follow-tabbar"><span>Channels</span><span>Categories</span><span>Settings</span></div>
    </div>
  )}
  {app.slug === 'gridly' && (
    <div class="gridly-screen">
      <div class="gridly-menubar"><span>▦ Gridly</span><span class="gridly-keycap">⌃⌥G</span></div>
      <div class="gridly-canvas">
        <div class="gridly-win win-a"><span>Xcode</span></div>
        <div class="gridly-win win-b"><span>Safari</span></div>
        <div class="gridly-win win-c"><span>Notes</span></div>
        <div class="gridly-snap"><span>Left 1/2</span></div>
      </div>
      <div class="gridly-palette"><span>Layouts</span><span>Shortcuts</span><span>Snapping</span><b>⌘⌥←</b></div>
    </div>
  )}
  {app.slug === 'tickly' && (
    <div class="tickly-stage">
      <div class="tickly-popover">
        <div class="tickly-pop-head">
          <span class="tickly-mini">⌨</span>
          <span class="tickly-pop-title"><b>Tickly</b><small>Mechanical</small></span>
          <span class="tickly-power">⏻</span>
        </div>
        <div class="tickly-meter"><span>Volume</span><i><b style="width:50%"></b></i><small>50%</small></div>
        <div class="tickly-meter"><span>Pitch</span><i><b style="width:32%"></b></i><small>1.00×</small></div>
      </div>
      <div class="tickly-keys" aria-hidden="true">
        <div class="tickly-key-row"><span>Q</span><span>W</span><span class="is-pressed">E</span><span>R</span><span>T</span><span>Y</span><span>U</span><span>I</span><span>O</span><span>P</span></div>
        <div class="tickly-key-row"><span>A</span><span>S</span><span>D</span><span>F</span><span>G</span><span>H</span><span>J</span><span>K</span><span>L</span></div>
        <div class="tickly-key-row"><span>Z</span><span>X</span><span>C</span><span>V</span><span>B</span><span>N</span><span>M</span><span class="wide">space</span></div>
      </div>
      <span class="tickly-caption">Mechanical · 50%</span>
    </div>
  )}
  {app.slug === 'tessera' && (
    <div class="tessera-canvas">
      <div class="tessera-ring ring-a"></div>
      <div class="tessera-ring ring-b"></div>
      <div class="tessera-ring ring-c"></div>
      <div class="tessera-tile t1"></div><div class="tessera-tile t2"></div><div class="tessera-tile t3"></div>
      <span class="tessera-code">p5.js · 30 fps</span>
    </div>
  )}
</div>

<style>
  .bubble-demo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 38px;
  }
  .bubble-selected {
    max-width: 300px;
    padding: 12px 16px;
    border: 1px solid rgba(20, 20, 35, .08);
    border-radius: 12px;
    background: rgba(255, 255, 255, .88);
    box-shadow: 0 18px 40px rgba(30, 35, 80, .1);
    color: #2a2a35;
    font-size: 14px;
    line-height: 1.55;
  }
  .bubble-selected mark {
    padding: 0 3px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--app-accent) 20%, white);
    color: var(--app-accent);
  }
  .bubble-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    border-radius: 10px;
    background: #2b2b2f;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 16px 36px rgba(18, 18, 30, .24);
  }
  .bubble-bar span {
    padding: 5px 9px;
    border-radius: 5px;
  }
  .bubble-bar .bubble-search {
    padding-inline: 8px 5px;
  }
  .bubble-bar .bubble-active {
    background: var(--app-accent);
  }
  .bubble-bar .bubble-more {
    color: rgba(255, 255, 255, .55);
    letter-spacing: 1px;
  }
  .crate-app-shot {
    position: absolute;
    width: 78%;
    left: 11%;
    top: 18%;
    border-radius: 14px;
    border: 1px solid rgba(40, 35, 25, .14);
    box-shadow: 0 28px 60px rgba(60, 45, 25, .18);
    transform: rotate(-2deg);
  }

  /* Clippet */
  .clippet-window {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(340px, 82%);
    overflow: hidden;
    background: #fffdfb;
    border: 1px solid rgba(255, 141, 40, .18);
    border-radius: 18px;
    box-shadow: 0 32px 64px rgba(112, 64, 18, .18), 0 6px 16px rgba(26, 41, 71, .08);
    transform: translate(-50%, -50%) rotate(-1.5deg);
  }
  .clippet-top {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 10px;
    border-bottom: 1px solid rgba(112, 64, 18, .08);
  }
  .clippet-search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 5px;
    padding: 5px 7px;
    background: #f7f3ee;
    border-radius: 7px;
    color: #9a8e82;
    font-family: var(--mono);
    font-size: 7px;
  }
  .clippet-lens {
    color: #c4701a;
    font-size: 8px;
  }
  .clippet-tab {
    padding: 4px 6px;
    border-radius: 999px;
    color: #9a8e82;
    font-size: 7px;
    white-space: nowrap;
  }
  .clippet-tab.is-on {
    background: #fff0e0;
    color: #c4701a;
  }
  .clippet-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    padding: 9px;
  }
  .clippet-card {
    display: flex;
    flex-direction: column;
    min-height: 100px;
    padding: 8px;
    background: #fbfaf8;
    border: 1px solid rgba(26, 41, 71, .07);
    border-radius: 9px;
  }
  .clippet-card.is-active {
    background: #ffffff;
    border-color: #ffb15c;
    box-shadow: 0 0 0 2px rgba(255, 141, 40, .13);
  }
  .clippet-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #8d8175;
    font-family: var(--mono);
    font-size: 7px;
  }
  .clippet-key {
    display: grid;
    place-items: center;
    min-width: 11px;
    height: 11px;
    padding: 0 3px;
    background: #fff0e0;
    border-radius: 3px;
    color: #c4701a;
    font-size: 6px;
  }
  .clippet-card p {
    margin: 7px 0 0;
    color: #4b4a48;
    font-family: var(--mono);
    font-size: 6.5px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .clippet-card small {
    margin-top: auto;
    padding-top: 7px;
    color: #a79c90;
    font-size: 6px;
  }
  .clippet-thumb {
    display: grid;
    place-items: center;
    height: 44px;
    margin-top: 7px;
    background: linear-gradient(160deg, #fff4e8, #ffe3c4);
    border-radius: 5px;
    color: #c4701a;
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: .16em;
  }
  .clippet-swatch {
    display: flex;
    align-items: flex-end;
    height: 44px;
    margin-top: 7px;
    padding: 5px;
    background: #ff9f1a;
    border-radius: 5px;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 6px;
  }
  .clippet-shortcut {
    position: absolute;
    right: 8%;
    bottom: 9%;
    padding: 6px 9px;
    background: #1a2947;
    border-radius: 7px;
    color: #fff;
    font-family: var(--mono);
    font-size: 7px;
    box-shadow: 0 10px 22px rgba(26, 41, 71, .24);
  }

  /* Clutch */
  .clutch-stage {
    position: absolute;
    inset: 10%;
    overflow: hidden;
    background: linear-gradient(145deg, #eef5ff, #ffffff 58%, #e7f0ff);
    border: 1px solid rgba(59, 140, 255, .18);
    border-radius: 24px;
    box-shadow: 0 26px 60px rgba(33, 80, 160, .14);
  }
  .clutch-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(59, 140, 255, .06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 140, 255, .06) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }
  .clutch-corner {
    position: absolute;
    width: 48px;
    height: 48px;
    border: 1.5px dashed rgba(59, 140, 255, .38);
  }
  .clutch-corner.tl { top: 13px; left: 13px; border-right: 0; border-bottom: 0; border-radius: 10px 0 0 0; }
  .clutch-corner.tr { top: 13px; right: 13px; border-bottom: 0; border-left: 0; border-radius: 0 10px 0 0; }
  .clutch-corner.bl { bottom: 13px; left: 13px; border-top: 0; border-right: 0; border-radius: 0 0 0 10px; }
  .clutch-corner.br { right: 13px; bottom: 13px; border-top: 0; border-left: 0; border-radius: 0 0 10px 0; }
  .clutch-trail {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    filter: drop-shadow(0 8px 14px rgba(47, 124, 246, .28));
  }
  .clutch-hud {
    position: absolute;
    top: 17%;
    right: 7%;
    padding: 6px 9px;
    background: #16213a;
    border-radius: 7px;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 7px;
    box-shadow: 0 10px 24px rgba(22, 33, 58, .24);
  }
  .clutch-hint {
    position: absolute;
    bottom: 9%;
    left: 8%;
    color: rgba(26, 41, 71, .46);
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  /* Follow */
  .follow-phone {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    height: min(420px, 88%);
    aspect-ratio: .52;
    padding: 10px 11px 9px;
    overflow: hidden;
    background: #f7faff;
    border: 6px solid #101828;
    border-radius: 32px;
    box-shadow: 0 34px 70px rgba(16, 24, 40, .28);
    transform: translate(-50%, -50%) rotate(2deg);
  }
  .follow-island {
    width: 48px;
    height: 12px;
    margin: 0 auto 8px;
    background: #101828;
    border-radius: 999px;
  }
  .follow-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #101828;
    font-size: 9px;
    font-weight: 600;
  }
  .follow-top-add {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    background: #e5f2ff;
    border-radius: 50%;
    color: #0a84ff;
    font-size: 9px;
    line-height: 1;
  }
  .follow-total {
    margin-top: 8px;
    padding: 8px 9px;
    background: linear-gradient(135deg, #e8f2ff, #ffffff);
    border: 1px solid rgba(10, 132, 255, .12);
    border-radius: 11px;
  }
  .follow-total small {
    display: block;
    color: #6b7a90;
    font-family: var(--mono);
    font-size: 5.5px;
    letter-spacing: .14em;
  }
  .follow-total strong {
    display: block;
    margin-top: 1px;
    color: #0a2540;
    font-size: 20px;
    letter-spacing: -.05em;
    line-height: 1.1;
  }
  .follow-delta {
    display: inline-block;
    margin-top: 3px;
    padding: 2px 5px;
    background: rgba(33, 163, 93, .12);
    border-radius: 999px;
    color: #1a8f52;
    font-size: 5.5px;
    font-weight: 600;
  }
  .follow-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 32px;
    margin: 8px 2px 5px;
  }
  .follow-bars i {
    flex: 1;
    height: var(--h);
    background: linear-gradient(#5aa9ff, #0a84ff);
    border-radius: 2px 2px 0 0;
    opacity: .78;
  }
  .follow-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .follow-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px;
    background: #ffffff;
    border: 1px solid rgba(16, 24, 40, .06);
    border-radius: 7px;
  }
  .follow-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    color: #ffffff;
    font-size: 5.5px;
    font-weight: 700;
  }
  .follow-avatar.gh { background: #24292f; }
  .follow-avatar.yt { background: #ff3b30; }
  .follow-avatar.ig { background: linear-gradient(145deg, #f9ce34, #ee2a7b 55%, #6228d7); }
  .follow-site {
    flex: 1;
    min-width: 0;
  }
  .follow-site b {
    display: block;
    color: #101828;
    font-size: 6.5px;
    line-height: 1.3;
  }
  .follow-site small {
    display: block;
    color: #8a94a6;
    font-size: 5.5px;
    line-height: 1.3;
  }
  .follow-row > strong {
    color: #101828;
    font-size: 6.5px;
  }
  .follow-tabbar {
    display: flex;
    justify-content: space-around;
    margin-top: auto;
    padding-top: 5px;
    border-top: 1px solid rgba(16, 24, 40, .06);
    color: #8a94a6;
    font-size: 5px;
  }

  /* Gridly */
  .gridly-screen {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(370px, 84%);
    overflow: hidden;
    background: linear-gradient(160deg, #241c44, #151129 70%);
    border-radius: 18px;
    box-shadow: 0 32px 66px rgba(43, 25, 110, .3);
    transform: translate(-50%, -50%) rotate(1.5deg);
  }
  .gridly-menubar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 11px;
    color: rgba(255, 255, 255, .68);
    font-family: var(--mono);
    font-size: 7px;
  }
  .gridly-keycap {
    padding: 3px 5px;
    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 4px;
    color: rgba(255, 255, 255, .7);
    font-size: 6px;
  }
  .gridly-canvas {
    position: relative;
    height: 205px;
    margin: 0 9px;
    overflow: hidden;
    background: linear-gradient(150deg, #3a2e71, #1c1738);
    border-radius: 9px;
  }
  .gridly-canvas::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .05) 1px, transparent 1px);
    background-size: 33.333% 33.333%;
  }
  .gridly-win {
    position: absolute;
    padding: 6px;
    background: rgba(255, 255, 255, .93);
    border-radius: 6px;
    color: #2b2354;
    font-size: 6px;
    box-shadow: 0 8px 18px rgba(8, 4, 28, .25);
  }
  .gridly-win span {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .gridly-win span::before {
    content: "";
    width: 4px;
    height: 4px;
    margin-right: 9px;
    background: #c9c3dd;
    border-radius: 50%;
    box-shadow: 6px 0 #c9c3dd, 12px 0 #c9c3dd;
  }
  .gridly-win.win-a { top: 9px; left: 9px; width: 47%; height: 52%; }
