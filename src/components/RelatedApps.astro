---
import { apps } from '../data/apps';
import Text from './Text.astro';
import { SITE } from '../data/site';
const { current } = Astro.props;
const related = [...apps]
  .sort((a, b) => Number(a.status === 'in-development') - Number(b.status === 'in-development'))
  .filter((app) => app.slug !== current)
  .slice(0, 4);
---
<section class="related section">
  <div class="shell">
  <div class="section-head section-head-compact">
    <p class="eyebrow"><Text en={`More from ${SITE.shortName}`} zh={`${SITE.nameZh}的其他产品`} /></p>
  </div>
  <div class="related-grid">
    {related.map((app) => (
      <a class="related-card" href={`/apps/${app.slug}/`}>
        <img src={app.icon} alt="" width="48" height="48" loading="lazy" />
        <div><h3>{app.name}</h3><p><Text en={app.tagline.en} zh={app.tagline.zh} /></p></div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
  </div>
</section>
