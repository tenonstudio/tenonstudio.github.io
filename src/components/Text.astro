---
interface Props {
  en: string;
  zh: string;
  tag?: string;
  class?: string;
  preline?: boolean;
}
const { en, zh, tag = 'span', class: className, preline = false } = Astro.props;
const Tag = tag;
---
<Tag data-lang="en" class:list={[className, { 'is-preline': preline }]}>{en}</Tag><Tag data-lang="zh" class:list={[className, { 'is-preline': preline }]}>{zh}</Tag>
