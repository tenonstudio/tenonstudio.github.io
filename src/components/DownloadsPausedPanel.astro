---
import type { App } from '../data/apps';
import Text from './Text.astro';
const { app } = Astro.props as { app: App };
---
<section class="download-panel paused-panel" style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}>
  <div class="download-copy">
    <p class="eyebrow"><Text en="Downloads paused" zh="下载暂停" /></p>
    <h2><Text en={`${app.name} downloads are temporarily unavailable.`} zh={`${app.name} 暂时不提供下载。`} /></h2>
    <p>
      <Text
        en="We have paused direct downloads for now. Support and license pages remain available; email us if you need a copy or help with an existing install."
        zh="我们暂时暂停了直接下载。支持和授权页面仍然可用；如果你需要安装包，或需要帮助处理已有安装，请发邮件给我们。"
      />
    </p>
    <div class="download-actions">
      <a class="button button-dark" href={`/apps/${app.slug}/support.html`}><Text en="Contact support" zh="联系支持" /> <span aria-hidden="true">→</span></a>
      {app.buy && <a class="text-link" href={app.buy}><Text en="License" zh="授权" /> <span aria-hidden="true">→</span></a>}
    </div>
    <p class="fine-print"><Text en={`${app.platform} · Downloads paused`} zh={`${app.platform} · 下载暂停`} /></p>
  </div>
  <img class="download-icon" src={app.icon} alt="" width="120" height="120" loading="lazy" />
</section>

<style>
  .paused-panel {
    background:
      radial-gradient(circle at 15% 15%, color-mix(in srgb, var(--app-accent) 12%, white), transparent 55%),
      linear-gradient(135deg, #f7f7fb, #ffffff 72%);
  }

  .paused-panel .download-icon {
    opacity: .9;
  }
</style>
