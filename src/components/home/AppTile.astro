---
interface Props {
  label: string;
  icon?: string;
  glyph?: 'files' | 'terminal' | 'notes' | 'music' | 'settings';
  class?: string;
  eager?: boolean;
}

const { label, icon, glyph, class: className, eager = false } = Astro.props;
---
<span class:list={['app-tile', glyph && `app-tile--${glyph}`, className]} title={label}>
  {icon ? (
    <img
      src={icon}
      alt=""
      width="80"
      height="80"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <span class="app-tile-glyph" aria-hidden="true">
      {glyph === 'files' && (
        <svg viewBox="0 0 32 32" fill="none">
          <path
            d="M5 10.2A3.2 3.2 0 0 1 8.2 7h5.2c.9 0 1.75.34 2.4.95l1.9 1.8h6.1a3.2 3.2 0 0 1 3.2 3.2v9.85A3.2 3.2 0 0 1 23.8 26H8.2A3.2 3.2 0 0 1 5 22.8z"
            fill="white"
            fill-opacity=".94"
          />
        </svg>
      )}
      {glyph === 'terminal' && (
        <svg viewBox="0 0 32 32" fill="none">
          <path
            d="m9 10 6.5 6L9 22M17.5 22H24"
            stroke="white"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
      {glyph === 'notes' && (
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M10 11h12M10 16h12M10 21h8" stroke="white" stroke-width="2.6" stroke-linecap="round" />
        </svg>
      )}
      {glyph === 'music' && (
        <svg viewBox="0 0 32 32" fill="none">
          <path
            d="M14 22.5a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm0 0V9.5l13-2.5v10"
            stroke="white"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="23" cy="20" r="4" stroke="white" stroke-width="2.3" />
        </svg>
      )}
      {glyph === 'settings' && (
        <svg viewBox="0 0 32 32" fill="none">
          <path
            d="M11 8v16M21 8v16M6 19h10M16 13h10"
            stroke="white"
            stroke-width="2.3"
            stroke-linecap="round"
          />
          <circle cx="11" cy="14" r="2.6" fill="white" />
          <circle cx="21" cy="18" r="2.6" fill="white" />
        </svg>
      )}
    </span>
  )}
</span>
