---
import Text from '../Text.astro';
---
<div class="bubble-visual" aria-hidden="true">
  <div class="bubble-doc">
    <p class="bubble-copy">
      <Text en="Every selection deserves" zh="每一次选择，都值得" class="bubble-lead" /><mark><Text en="a better toolbar." zh="更好的工具条。" /></mark>
    </p>
    <p class="bubble-sub">
      <Text
        en="Search, copy, open a link — without leaving the app."
        zh="搜索、复制、打开链接——无需离开当前 App。"
      />
    </p>
  </div>

  <div class="bubble-bar">
    <span class="bubble-action">
      <svg viewBox="0 0 16 16" fill="none">
        <circle cx="6.8" cy="6.8" r="4.2" stroke="currentColor" stroke-width="1.35" />
        <path d="m10 10 3.4 3.4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      </svg>
    </span>
    <span class="bubble-action">
      <svg viewBox="0 0 16 16" fill="none">
        <circle cx="4.1" cy="4.1" r="1.9" stroke="currentColor" stroke-width="1.2" />
        <circle cx="11.9" cy="4.1" r="1.9" stroke="currentColor" stroke-width="1.2" />
        <path d="M5.7 5.5 10.3 13M10.3 5.5 5.7 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </span>
    <span class="bubble-action">
      <svg viewBox="0 0 16 16" fill="none">
        <rect x="5.2" y="2.8" width="8" height="9" rx="1.8" stroke="currentColor" stroke-width="1.2" />
        <path d="M10.8 13.2H4.4a1.7 1.7 0 0 1-1.7-1.7V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </span>
    <span class="bubble-action">
      <svg viewBox="0 0 16 16" fill="none">
        <path d="M5 4.2h6a1.5 1.5 0 0 1 1.5 1.5V13H3.5V5.7A1.5 1.5 0 0 1 5 4.2Z" stroke="currentColor" stroke-width="1.2" />
        <path d="M6.2 4.2V3.3A1.3 1.3 0 0 1 7.5 2h1A1.3 1.3 0 0 1 9.8 3.3v.9" stroke="currentColor" stroke-width="1.2" />
      </svg>
    </span>
    <span class="bubble-action">
      <svg viewBox="0 0 16 16" fill="none">
        <path d="M6.5 9.5 9.5 6.5M5.1 11.4l-1.2 1.2a2.4 2.4 0 0 1-3.4-3.4l2.4-2.4A2.4 2.4 0 0 1 6.3 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="m10.9 4.6 1.2-1.2a2.4 2.4 0 0 1 3.4 3.4l-2.4 2.4A2.4 2.4 0 0 1 9.7 10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </span>
    <span class="bubble-sep"></span>
    <span class="bubble-brand">B</span>
  </div>
</div>
