---
import AppTile from './AppTile.astro';
import { appTiles } from '../../data/home';
---
<div class="mac-icons-container" aria-hidden="true">
  {appTiles.map((tile, index) => (
    <AppTile
      label={tile.label}
      icon={'icon' in tile ? tile.icon : undefined}
      glyph={'glyph' in tile ? tile.glyph : undefined}
      class={`mac-icon icon-${index + 1}`}
    />
  ))}
</div>
