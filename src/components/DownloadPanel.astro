---
import type { App } from '../data/apps';
import Text from './Text.astro';
const { app } = Astro.props as { app: App };
---
<section class="download-panel" style={`--app-accent:${app.accent};--app-soft:${app.accentSoft};`}>
  <div class="download-copy">
    <p class="eyebrow"><Text en="Available now" zh="现在可用" /></p>
    <h2><Text en={`Make ${app.name} part of your day.`} zh={`把 ${app.name} 放进你的日常。`} /></h2>
    <p><Text en="Download the app, try every feature for 14 days, then keep it with a lifetime license." zh="下载 App，14 天试用全部功能；继续使用购买终身授权即可。" /></p>
    <div class="download-actions">
      <a class="button button-dark" href={app.download}>
        <Text en={`Download ${app.name}`} zh={`下载 ${app.name}`} /> <span aria-hidden="true">↓</span>
      </a>
      {app.buy && <a class="text-link" href={app.buy}><Text en="Buy a license" zh="购买授权" /> <span aria-hidden="true">→</span></a>}
    </div>
    <p class="fine-print"><Text en="macOS · 14-day trial · One-time purchase" zh="macOS · 14 天试用 · 买断授权" /></p>
  </div>
  <img class="download-icon" src={app.icon} alt="" width="120" height="120" loading="lazy" />
</section>
